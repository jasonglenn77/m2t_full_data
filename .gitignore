.claude/
__pycache__/
*.pyc

# Ignore ONLY large daily parquet files
data/raw/daily/*.parquet

# Ignore large numpy file
data/processed/signatures/signatures.npy

# v2 pair ledger — ~3 GB, far over GitHub's 100 MB hard limit. It was only
# ever untracked, which left it one `git add -A` away from wrecking the repo.
data/state/pair_ledger.parquet
data/state/pair_ledger.parquet.tmp

# Raw GIS source files (ServicePoints can exceed GitHub's 100 MB hard limit)
GIS_mapping/*.csv

# Memmap swap files left from interrupted rolling updates
data/processed/signatures/signatures.npy.tmp

# Per-week output snapshots from run_weeks.ps1 (~45 MB/week; local history,
# not source). Keep them on the machine that runs the model.
data/archive_v2/

# Where run_monday.ps1 tracks the v1 signature window. Machine-specific,
# like the ledger position — committing it would desync the two machines.
data/state/v1_window_end.txt
